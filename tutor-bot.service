[Unit]
Description=Tutor Bot Telegram Polling Service
After=network.target tutor-web.service

[Service]
User=root
WorkingDirectory=/var/www/Tutor_bot
EnvironmentFile=/var/www/Tutor_bot/.env
ExecStart=/var/www/Tutor_bot/venv/bin/python telegram.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
