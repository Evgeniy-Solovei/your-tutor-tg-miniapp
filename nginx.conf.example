# /etc/nginx/sites-available/tutorbot
#
# ВАЖНО: блок demo на 443 добавляй ТОЛЬКО после certbot.
# Сначала HTTP для demo → certbot → потом раскомментируй HTTPS demo.
#
#   your-tutor.live-dev.by      → tutor_web  :8005
#   demo.your-tutor.live-dev.by → tutor_site :8006

server {
    listen 80;
    server_name your-tutor.live-dev.by;
    return 301 https://$host$request_uri;
}

# Demo: сначала только HTTP (для выпуска сертификата)
server {
    listen 80;
    server_name demo.your-tutor.live-dev.by;

    client_max_body_size 25m;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location /static/ {
        proxy_pass http://127.0.0.1:8006;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        proxy_pass http://127.0.0.1:8006;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8006;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
    }
}

server {
    listen 443 ssl http2;
    server_name your-tutor.live-dev.by;

    access_log /var/log/nginx/tutorbot_access.log;
    error_log /var/log/nginx/tutorbot_error.log;

    ssl_certificate /etc/letsencrypt/live/your-tutor.live-dev.by/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-tutor.live-dev.by/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 25m;

    location /static/ {
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 7d;
        add_header Cache-Control "public";
    }

    location / {
        proxy_pass http://127.0.0.1:8005;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
    }
}

# После: certbot --nginx -d demo.your-tutor.live-dev.by
# certbot сам допишет ssl-server для demo. Не копируй SSL-блок вручную до выпуска серта.
