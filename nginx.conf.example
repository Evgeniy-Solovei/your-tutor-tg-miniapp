# Конфигурация Nginx для Tutor Bot (/etc/nginx/sites-available/tutorbot)

server {
    listen 80;
    server_name your-tutor.live-dev.by;

    access_log /var/log/nginx/tutorbot_access.log;
    error_log /var/log/nginx/tutorbot_error.log;

    # Все запросы (Mini App, API, static, admin) проксируются на Docker-приложение
    location / {
        proxy_pass http://127.0.0.1:8005;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
